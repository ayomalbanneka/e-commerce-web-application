# Copy this file to .env and fill in values

# MySQL
# Database name defaults to `shop` in code (see connection.php)
MYSQL_PWD="your_mysql_password"

# SMTP (e.g., Gmail)
G_EMAIL="your_sender_email@example.com"
G_APP_PASSWORD="your_email_app_password"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
# Redirect URI used in code
# Ensure this exact URI is configured in the Google Cloud Console for your OAuth client
# Example (default in code):
# http://localhost/shop/home.php

# Facebook OAuth
FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_APP_SECRET="your_facebook_app_secret"
# Redirect URI used in code
# Ensure this exact URI is configured in your Facebook app settings
# Example (default in code):
# http://localhost/shop/home.php
